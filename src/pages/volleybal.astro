---
import Layout from '../layouts/Layout.astro';

const photos = [
    {
        src: '/volleyball/volleybal-02.jpg',
        alt: 'Rood Wit Zaanstad volleybalteam',
    },
    {
        src: '/volleyball/volleybal-03.jpg',
        alt: 'Rood Wit Zaanstad volleybalteam',
    },
    {
        src: '/volleyball/volleybal-04.jpg',
        alt: 'Rood Wit Zaanstad volleyballers',
    },
    {
        src: '/volleyball/volleybal-05.jpg',
        alt: 'Rood Wit Zaanstad volleybalteam',
    },
    {
        src: '/volleyball/volleybal-06.jpg',
        alt: 'Rood Wit Zaanstad volleybalwedstrijd',
    },
    {
        src: '/volleyball/volleybal-07.jpg',
        alt: 'Rood Wit Zaanstad volleybalteam',
    },
];
---

<Layout title="Volleybal | Rood Wit Zaanstad">
    <main class="min-h-screen bg-gray-50">
        <section class="mx-auto max-w-5xl px-6 py-12 sm:px-8 lg:py-16">

            <header class="mb-8">
                <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-red-700">
                    Rood Wit Zaanstad
                </p>

                <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
                    Volleybal
                </h1>

                <div class="mt-4 h-1 w-16 bg-red-700"></div>
            </header>

            <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-200 sm:p-6">

                <!-- Grote hoofdafbeelding -->
                <a
                        href="/volleyball/volleybal-01.jpg"
                        target="_blank"
                        rel="noopener noreferrer"
                >
                    <img
                            src="/volleyball/volleybal-01.jpg"
                            alt="Rood Wit Zaanstad volleybal"
                            class="w-full rounded-xl"
                    />
                </a>

                <!-- Overige foto's -->
                <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {
                        photos.map((photo) => (
                                <a
                                        href={photo.src}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="block overflow-hidden rounded-xl"
                                >
                                    <img
                                            src={photo.src}
                                            alt={photo.alt}
                                            class="aspect-[4/3] w-full object-cover transition-transform duration-300 hover:scale-105"
                                            loading="lazy"
                                    />
                                </a>
                        ))
                    }
                </div>

            </div>
        </section>
    </main>
</Layout>