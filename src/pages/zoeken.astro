---
import Layout from '../layouts/Layout.astro';

const searchItems = [
    {
        title: 'Rood Wit Zaanstad',
        description: 'Sport- en Jongerenvereniging Rood-Wit Zaanstad in Zaandam.',
        url: '/',
    },
    {
        title: 'Contact',
        description: 'Contactgegevens, telefoonnummer en contactformulieren van Rood Wit Zaanstad.',
        url: '/contact',
    },
    {
        title: 'Bestuur',
        description: 'Het bestuur van Rood Wit Zaanstad.',
        url: '/bestuur',
    },
    {
        title: 'Sponsoren',
        description: 'Onze sponsors – Samen sterk voor Rood-Wit Zaanstad.',
        url: '/sponsoren',
    },
    {
        title: 'Jeugd',
        description: 'Informatie over de jeugd van Rood Wit Zaanstad.',
        url: '/jeugd',
    },
    {
        title: 'Senioren',
        description: 'Informatie en foto’s van de senioren van Rood Wit Zaanstad.',
        url: '/senioren',
    },
    {
        title: 'Volleybal',
        description: 'Volleybal bij Rood Wit Zaanstad.',
        url: '/volleybal',
    },
    {
        title: 'Lidmaatschap',
        description: 'Informatie over het lidmaatschap en het aanmeldingsformulier.',
        url: '/lidmaatschap',
    },
    {
        title: 'Damesteam',
        description: 'Informatie over het damesteam van Rood Wit Zaanstad.',
        url: '/damesteam',
    },
    {
        title: 'Meedoen Zaanstad Regeling',
        description: 'Informatie over de Meedoen Zaanstad regeling.',
        url: '/meedoen-zaanstad-regeling',
    },
];
---

<Layout title="Zoekresultaten | Rood Wit Zaanstad">
    <main class="bg-gray-100 px-4 py-6 sm:px-6">
        <section class="mx-auto max-w-3xl bg-white p-5 shadow-sm">

            <h1 class="text-3xl font-bold text-gray-900">
                Zoekresultaten
            </h1>

            <div id="search-results" class="mt-6"></div>

        </section>
    </main>
</Layout>

<script define:vars={{ searchItems }}>
    const results = document.querySelector('#search-results');

    if (results) {
        const params = new URLSearchParams(window.location.search);
        const query = params.get('q')?.trim() ?? '';

        const normalizedQuery = query.toLowerCase();

        const matches = normalizedQuery
            ? searchItems.filter((item) =>
                `${item.title} ${item.description}`
                    .toLowerCase()
                    .includes(normalizedQuery)
            )
            : searchItems;

        if (!query) {
            results.innerHTML = `
                <p class="text-sm leading-6 text-gray-600">
                    Op deze website vind je de volgende pagina's:
                </p>

                <div class="mt-5 space-y-3">
                    ${matches.map((item) => `
                        <a
                            href="${item.url}"
                            class="block border border-gray-200 p-4 transition-colors hover:border-red-600 hover:bg-gray-50"
                        >
                            <h2 class="font-bold text-gray-900">
                                ${item.title}
                            </h2>

                            <p class="mt-1 text-sm leading-6 text-gray-600">
                                ${item.description}
                            </p>
                        </a>
                    `).join('')}
                </div>
            `;
        } else if (matches.length === 0) {
            results.innerHTML = `
                <p class="text-sm text-gray-600">
                    Geen resultaten gevonden voor
                    <strong class="mx-1">${query}</strong>.
                </p>
            `;
        } else {
            results.innerHTML = `
                <p class="text-sm text-gray-600">
                    ${matches.length} resultaat${matches.length === 1 ? '' : 'en'}
                    gevonden voor
                    <strong class="mx-1">${query}</strong>.
                </p>

                <div class="mt-5 space-y-4">
                    ${matches.map((item) => `
                        <a
                            href="${item.url}"
                            class="block border border-gray-200 p-4 transition-colors hover:border-red-600 hover:bg-gray-50"
                        >
                            <h2 class="font-bold text-gray-900">
                                ${item.title}
                            </h2>

                            <p class="mt-1 text-sm leading-6 text-gray-600">
                                ${item.description}
                            </p>
                        </a>
                    `).join('')}
                </div>
            `;
        }
    }
</script>