---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Senioren | Rood Wit Zaanstad">
    <main class="bg-gray-100 px-4 py-6 sm:px-6">
        <section class="mx-auto max-w-3xl bg-white p-5 shadow-sm">

            <!-- Teamfoto -->
            <a
                    href="/senioren/team-foto.jpg"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block"
            >
                <img
                        src="/senioren/team-foto.jpg"
                        alt="Seniorenteam Rood Wit Zaanstad"
                        class="w-full"
                />
            </a>

            <!-- Foto leden -->
            <a
                    href="/senioren/leden.webp"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 block"
            >
                <img
                        src="/senioren/leden.webp"
                        alt="Leden van Rood Wit Zaanstad"
                        class="w-full"
                        loading="lazy"
                />
            </a>

        </section>
    </main>
</Layout>