---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sponsoren | Rood Wit Zaanstad">
    <main class="min-h-screen bg-gray-50">
        <section class="mx-auto max-w-5xl px-6 py-12 sm:px-8 lg:py-16">

            <header class="mb-10">
                <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-red-700">
                    Rood Wit Zaanstad
                </p>

                <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
                    Sponsoren
                </h1>

                <div class="mt-4 h-1 w-16 bg-red-700"></div>
            </header>

            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8">

                <h2 class="text-2xl font-bold text-gray-900">
                    Onze sponsors – Samen sterk voor Rood-Wit Zaanstad
                </h2>

                <div class="mt-6 space-y-4 text-base leading-7 text-gray-700">
                    <p>
                        Sport- en Jongerenvereniging Rood-Wit Zaanstad is trots op haar
                        sponsoren. Dankzij hun betrokkenheid kunnen wij onze leden een
                        veilige, sportieve en positieve omgeving bieden. Onze sponsors
                        leveren een onmisbare bijdrage aan de ontwikkeling van jeugd en
                        senioren, het onderhoud van onze faciliteiten en de organisatie
                        van sportieve activiteiten.
                    </p>

                    <p>
                        Wij danken al onze sponsoren voor hun vertrouwen en steun.
                    </p>
                </div>

                <div class="mt-10 border-t border-gray-200 pt-8">
                    <h3 class="text-xl font-bold text-gray-900">
                        Hoofdsponsor
                    </h3>

                    <p class="mt-2 text-gray-600">
                        Vanaf seizoen 2023/2024 tot en met 2025/2026
                    </p>

                    <div class="mt-8 flex justify-center">
                        <img
                                src="/sponsors/ayal-kaas.png"
                                alt="Ayal Kaas"
                                class="h-auto w-full max-w-3xl rounded-lg"
                        />
                    </div>
                </div>

            </div>
        </section>
    </main>
</Layout>