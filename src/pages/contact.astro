                            </label>

                            <input
                                    id="jeugd-email"
                                    type="email"
                                    name="email"
                                    class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
                            />
