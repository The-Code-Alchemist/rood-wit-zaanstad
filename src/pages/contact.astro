                </div>

                <!-- Ledenadministratie -->
                <div
                        id="panel-ledenadministratie"
                        role="tabpanel"
                        class="contact-panel mt-8"
                        data-panel="ledenadministratie"
                        hidden
                >
                    <h3 class="text-lg font-bold text-gray-900">
                        Ledenadministratie
                    </h3>

                    <form class="mt-5 space-y-4">
                        <div>
                            <label
                                    for="leden-naam"
                                    class="block text-sm font-medium text-gray-700"
                            >
                                Naam
                            </label>

                            <input
                                    id="leden-naam"
                                    type="text"
                                    name="naam"
                                    class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
                            />
                        </div>

                        <div>
                            <label
                                    for="leden-email"
                                    class="block text-sm font-medium text-gray-700"
                            >
                                E-mailadres
                            </label>

                            <input
                                    id="leden-email"
                                    type="email"
                                    name="email"
                                    class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
                            />
                        </div>

                        <div>
                            <label
                                    for="leden-onderwerp"
                                    class="block text-sm font-medium text-gray-700"
                            >
                                Onderwerp
                            </label>

                            <input
                                    id="leden-onderwerp"
                                    type="text"
                                    name="onderwerp"
                                    class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
                            />
                        </div>

                        <div>
                            <label
                                    for="leden-bericht"
                                    class="block text-sm font-medium text-gray-700"
                            >
                                Bericht
                            </label>

                            <textarea
                                    id="leden-bericht"
                                    name="bericht"
                                    rows="6"
                                    class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
                            ></textarea>
                        </div>

                        <div class="pt-2">
                            <button
                                    type="submit"
                                    class="rounded-lg bg-red-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-red-800"
                            >
                                Verzenden
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Jeugd -->
                <div
                        id="panel-jeugd"
                        role="tabpanel"
                        class="contact-panel mt-8"
                        data-panel="jeugd"
                        hidden
                >
                    <h3 class="text-lg font-bold text-gray-900">
                        Jeugd
                    </h3>

                    <form class="mt-5 space-y-4">
                        <div>
                            <label
                                    for="jeugd-naam"
                                    class="block text-sm font-medium text-gray-700"
                            >
                                Naam
                            </label>

                            <input
                                    id="jeugd-naam"
                                    type="text"
                                    name="naam"
                                    class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
                            />
                        </div>

                        <div>
                            <label
                                    for="jeugd-email"
                                    class="block text-sm font-medium text-gray-700"
                            >
